# Copy this file to .env and fill in your own account.
# Do not commit .env.

HYPERAPI_BASE_URL=https://hyperapi.cc
HYPERAPI_USERNAME=your_username_or_email
HYPERAPI_PASSWORD=your_password

# Filled automatically by scripts/setup-hyperapi-token.sh.
# Required by token-based fetching.
# HYPERAPI_USER_ID=123

# Optional Keychain settings.
HYPERAPI_KEYCHAIN_SERVICE=newapi-account-scraper.hyperapi

# Optional. Fill only if your account enables 2FA.
# HYPERAPI_2FA_CODE=123456

# Optional. Fill only if the site enables Cloudflare Turnstile on login.
# HYPERAPI_TURNSTILE_TOKEN=

# Optional display switches.
HYPERAPI_HIDE_EXHAUSTED=false
HYPERAPI_INCLUDE_ALL_SUBSCRIPTIONS=true

# Optional desktop widget position, measured from top-left of the primary screen.
HYPERAPI_WIDGET_X=38
HYPERAPI_WIDGET_Y=240
HYPERAPI_WIDGET_WIDTH=344
HYPERAPI_WIDGET_HEIGHT=430
